# Dictate Environment Configuration Example
# Copy to ~/.config/dictate/.env

# mistral | groq | deepgram | local
TRANSCRIPTION_PROVIDER=mistral
MISTRAL_API_KEY=your-mistral-api-key-here

# Deepgram (batch/prerecorded STT). Auth is `Authorization: Token <key>`, not Bearer.
# DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_BASE_URL=https://api.deepgram.com
# Note: live_typing (word-by-word) still requires TRANSCRIPTION_PROVIDER=mistral —
# only Mistral has a realtime WebSocket path in dictate today. Deepgram works with
# the batch profiles (smart_paste / batch_clip).

# How dictation behaves (pick one):
#   live_typing  — words appear as you speak (Mistral realtime, use with --daemon)
#   smart_paste  — speak, stop, polished text pasted once (daemon + LLM)
#   batch_clip   — record, transcribe once, local cleanup only
DICTATE_PROFILE=live_typing

# Legacy (optional): BATCH_MODE=true forces batch STT; prefer DICTATE_PROFILE instead.
# BATCH_MODE=false
# TRANSCRIPTION_MODE=auto

MISTRAL_MODEL=voxtral-mini-latest
MISTRAL_REALTIME_MODEL=voxtral-mini-transcribe-realtime-2602
MISTRAL_REALTIME_DELAY_MS=480

TRANSCRIPTION_LANGUAGE=auto
TRANSCRIPTION_TIMEOUT_SECONDS=60
TRANSCRIPTION_MAX_RETRIES=3

# Where text goes when you omit --pipe-to on the command line
# type | clipboard | paste | stdout
SHORTCUT_OUTPUT=type
SHORTCUT_DESKTOP=hyprland
# Two shortcuts (see `dictate setup`):
# On Windows use CTRL,ALT,R / CTRL,ALT,SHIFT,R — Win+R is the Run dialog and
# cannot be registered. See docs/windows.md.
SHORTCUT_KEY_LIVE=SUPER,R
SHORTCUT_KEY_SMART=SUPER,SHIFT,R
# Legacy single key:
# SHORTCUT_KEY=SUPER,R

# Voice corrections on session text (smart / VAD stream)
CONTEXT_EDITING=true

# Experimental waveform pill (requires `cargo build --features overlay`)
# ENABLE_OVERLAY=false

ENABLE_AUDIO_FEEDBACK=true
BEEP_VOLUME=0.1

# --- LLM text polish (separate from speech-to-text above) ---
# Polish runs on OpenCode Zen (`big-pickle`), which is TEXT-ONLY — it never handles
# audio. Transcription keeps using MISTRAL_API_KEY / the provider set above.
POLISH_PROVIDER=auto               # auto | opencode | mistral | ollama
OPENCODE_API_KEY=
# OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# Optional text.toml beside this file:
#
# [polish]
# enabled = true
# model = "big-pickle"
# on_failure = "fallback"
# max_tokens = 2048   # big-pickle is a reasoning model: reasoning tokens count
#                     # against max_tokens, so anything under ~1024 returns empty
#                     # text. Values below 2048 are raised to 2048 automatically.
#
# [dictionary] ...